{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=Day1WebApi.db"
  },
  "Url": {
    "Profil": "",
    "Referensi":  ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "SQLite",
        "Args": {
          "sqliteDbPath": "logs/log.db",
          "tableName": "Logs"
        }
      }
    ]
  }
}
